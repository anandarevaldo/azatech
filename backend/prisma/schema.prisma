generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  PRIA
  WANITA
}

model User {
  id             BigInt   @id @default(autoincrement())
  name           String   @db.VarChar(100)
  email          String   @unique @db.VarChar(150)
  password       String   @db.VarChar(255)
  refreshTokenHash String? @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[] @relation("OrderCreatedBy")

  @@map("users")
}

model Product {
  id          BigInt    @id @default(autoincrement())
  productCode String    @unique @db.VarChar(20)
  productName String    @db.VarChar(150)
  imageUrl    String?   @db.Text
  stock       Int       @default(0)
  price       Decimal   @db.Decimal(12, 2)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orderItems OrderItem[]

  @@index([productName])
  @@index([deletedAt])
  @@map("products")
}

model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  customerName    String    @db.VarChar(150)
  customerAddress String    @db.VarChar(255)
  gender          Gender
  birthDate       DateTime  @db.Date
  phone           String?   @db.VarChar(20)
  imageUrl        String?   @db.Text
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders Order[]

  @@index([customerName])
  @@index([deletedAt])
  @@map("customers")
}

model Order {
  id           BigInt   @id @default(autoincrement())
  orderNumber  String   @unique @db.VarChar(30)
  customerId   String   @db.Uuid
  createdById  BigInt
  orderDate    DateTime @default(now())
  totalAmount  Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer  Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User        @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items     OrderItem[]

  @@index([orderDate])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id        BigInt   @id @default(autoincrement())
  orderId   BigInt
  productId BigInt
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}
